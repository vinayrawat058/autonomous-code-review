# Copy to .env and fill in values. Never commit .env.

# Free key: https://console.groq.com (API Keys). No credit card on the free plan.
GROQ_API_KEY=gsk_your_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Vector RAG (Qdrant). Default = embedded on-disk store (no Docker).
# Leave QDRANT_URL empty unless you run a Qdrant server.
QDRANT_URL=
QDRANT_PATH=.qdrant
QDRANT_COLLECTION_CODE=codebase
QDRANT_COLLECTION_POLICY=policies
# fastembed = local model (first run downloads). hash = offline tests only.
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LangGraph checkpoint (sqlite survives API restart; memory for ephemeral/tests)
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_SQLITE_PATH=.checkpoints/langgraph.sqlite
# Seconds a paused review may wait for Approve/Reject
APPROVE_TTL_SECONDS=3600
# Ingest limits for pasted diffs
MAX_DIFF_CHARS=200000
MAX_DIFF_FILES=40

# GitHub PR on approve (optional). Create a classic PAT with `repo` scope:
# https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=
GITHUB_DEFAULT_BASE=main

# GitHub App + webhook (review real PRs). Create an App, install it on the repo,
# and point the webhook URL to https://<host>/api/github/webhook
# Events: Pull requests. Secret must match GITHUB_WEBHOOK_SECRET.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_REQUIRE_SECRET=true
GITHUB_WEBHOOK_REVIEW_DRAFTS=false
GITHUB_WEBHOOK_ASYNC=true
GITHUB_WEBHOOK_POST_REVIEW=true

# Sandbox (rewrite pytest). auto = Docker when daemon is up, else local.
# Build image: docker build -t autonomous-code-review-sandbox ./backend/sandbox
SANDBOX_BACKEND=auto
SANDBOX_IMAGE=autonomous-code-review-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY=256m
SANDBOX_CPUS=1
SANDBOX_NETWORK_NONE=true

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
